PORT=4000
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:3000
# For multiple frontends, prefer CLIENT_ORIGINS=https://app.example.com,https://www.example.com
CLIENT_ORIGINS=http://localhost:3000
# Set TRUST_PROXY=1 only when the server is behind a trusted reverse proxy
TRUST_PROXY=0
DB_PATH=./data/sakhya.db
# Optional encrypted-media storage settings
# MEDIA_DIR=./data/media
# MAX_MEDIA_BYTES=52428800
